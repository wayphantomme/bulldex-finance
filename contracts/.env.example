# ─── Bulldex Finance — Contracts Environment Variables ───────────────────────
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# Alchemy RPC endpoint for Sepolia testnet
# Get from: https://www.alchemy.com/ → Create app → Ethereum → Sepolia
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Deployer wallet private key (export from MetaMask)
# Must start with 0x, must be testnet ONLY
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_FROM_METAMASK

# Etherscan API key for contract verification
# Get from: https://etherscan.io/apis
ETHERSCAN_KEY=YOUR_ETHERSCAN_API_KEY

# Deployed contract addresses (fill after running each deploy script)
NEXT_PUBLIC_TOKEN_ADDRESS=
NEXT_PUBLIC_MUSDC_ADDRESS=
NEXT_PUBLIC_WETH_ADDRESS=
NEXT_PUBLIC_FACTORY_ADDRESS=
NEXT_PUBLIC_POOL_BDX_MUSDC=
NEXT_PUBLIC_POOL_BDX_WETH=
NEXT_PUBLIC_LENDING_ADDRESS=
NEXT_PUBLIC_STAKING_ADDRESS=
NEXT_PUBLIC_MASTERCHEF_ADDRESS=
NEXT_PUBLIC_VESTING_ADDRESS=
# Phase 3 — DAO Governance
NEXT_PUBLIC_GOVERNOR_ADDRESS=
NEXT_PUBLIC_TIMELOCK_ADDRESS=
