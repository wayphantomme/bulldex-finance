# ─── Bulldex Finance — Frontend Environment Variables ────────────────────────
# Copy to .env.local and fill in your values
# NEXT_PUBLIC_ prefix = exposed to browser (safe for public data only)

# Alchemy Sepolia RPC endpoint
NEXT_PUBLIC_SEPOLIA_RPC=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Deployed contract addresses (fill after running make deploy-sepolia)
NEXT_PUBLIC_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000

# WalletConnect project ID — get from https://cloud.walletconnect.com/
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=YOUR_WALLETCONNECT_PROJECT_ID
