# ─── Bulldex Finance — Frontend Environment Variables ────────────────────────
# Copy to .env.local and fill in values from: make deploy-sepolia

NEXT_PUBLIC_SEPOLIA_RPC=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=YOUR_WALLETCONNECT_PROJECT_ID

# Contract addresses — output from make deploy-sepolia
NEXT_PUBLIC_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_MUSDC_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_POOL_BDX_MUSDC=0x0000000000000000000000000000000000000000

# The Graph subgraph (after deploying with graph deploy)
NEXT_PUBLIC_SUBGRAPH_URL=https://api.studio.thegraph.com/query/YOUR_ID/bulldex-finance/v0.1.0
